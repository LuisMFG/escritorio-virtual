{
  "name": "escritorio-virtual",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n servidor,cliente -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared --noEmit && tsc -p shared/tsconfig.test.json --noEmit && tsc -p client --noEmit && tsc -p server --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "db:generate": "npm exec -w server -- drizzle-kit generate",
    "bot": "npm run bot -w server --",
    "assets:sync": "npm run assets:sync -w server --",
    "start": "NODE_ENV=production npm run start -w server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
