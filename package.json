{
  "name": "escritorio-virtual",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server",
    "vscode-extension"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n servidor,cliente,midia -c blue,green,magenta \"npm run dev -w server\" \"npm run dev -w client\" \"node scripts/livekit-dev.mjs\"",
    "build": "npm run build -w client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared --noEmit && tsc -p shared/tsconfig.test.json --noEmit && tsc -p client --noEmit && tsc -p server --noEmit && tsc -p vscode-extension --noEmit && tsc -p e2e --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "db:generate": "npm exec -w server -- drizzle-kit generate",
    "bot": "npm run bot -w server --",
    "assets:sync": "npm run assets:sync -w server --",
    "start": "npm run start -w server",
    "vscode:package": "npm run package -w vscode-extension",
    "e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "assets:figure": "npm run assets:figure -w server --",
    "assets:figure-check": "npm run assets:figure-check -w server --",
    "assets:furni": "npm run assets:furni -w server --",
    "assets:pets": "npm run assets:pets -w server --",
    "assets:costumes": "npm run assets:costumes -w server --",
    "medir:chamada": "npm run build && playwright test -c e2e/medicao/medicao.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
