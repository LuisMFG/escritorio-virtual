# Copie para .env (na raiz do projeto) e ajuste.

# Código de convite exigido na tela de entrada.
# Em desenvolvimento, se ficar vazio, o servidor usa "convite". Em produção é obrigatório.
INVITE_CODE=troque-este-codigo

# Token gratuito da HabboAssets (https://www.habboassets.com/api) — usado só no servidor.
HABBOASSETS_API_KEY=

# Domínio público (produção com docker compose + Caddy). Sem domínio próprio, use o IP da
# máquina com sslip.io, trocando os pontos por hífens: escritorio.203-0-113-10.sslip.io
DOMAIN=

# Servidor
PORT=2567
DATABASE_PATH=./data/sqlite.db
ASSET_CACHE_DIR=./data/asset-cache
