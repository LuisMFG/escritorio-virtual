# Copie para .env (na raiz do projeto) e ajuste.

# Código de convite exigido na tela de entrada.
# Em desenvolvimento, se ficar vazio, o servidor usa "convite". Em produção é obrigatório.
INVITE_CODE=troque-este-codigo

# Usuários (login) que são sempre administradores, separados por vírgula.
# Se ficar vazio, a primeira conta criada vira admin.
ADMIN_USERNAMES=

# Token gratuito da HabboAssets (https://www.habboassets.com/api) — usado só no servidor.
HABBOASSETS_API_KEY=

# Domínio público (produção com docker compose + Caddy). Sem domínio próprio, use o IP da
# máquina com sslip.io, trocando os pontos por hífens: escritorio.203-0-113-10.sslip.io
DOMAIN=

# Spotify (opcional): mostra no cartão a música que cada pessoa está ouvindo.
# Crie um app em https://developer.spotify.com/dashboard, cadastre o endereço de retorno abaixo
# e, no modo de desenvolvimento do Spotify, adicione o e-mail de quem vai conectar (até 25).
# Sem SPOTIFY_CLIENT_ID a integração fica desligada.
SPOTIFY_CLIENT_ID=
# Padrão em desenvolvimento: http://127.0.0.1:2567/api/spotify/callback (o Spotify não aceita
# "localhost"). Em produção: https://SEU-DOMINIO/api/spotify/callback
SPOTIFY_REDIRECT_URI=
# Para onde voltar depois de conectar. Em desenvolvimento: http://localhost:5173/
SPOTIFY_RETURN_URL=

# Backups diários do banco (às 3h, horário de Brasília). Guarda os últimos BACKUP_KEEP.
BACKUP_DIR=./data/backups
BACKUP_KEEP=7

# Anexos do chat (até 10 MB cada). Copie esta pasta junto com os backups.
UPLOAD_DIR=./data/uploads

# Jira Cloud (Fase 30). Vazio: o admin informa o endereço no painel.
JIRA_SITE=
# Chave que cifra os tokens do Jira (openssl rand -base64 32). Vazio: gerada em data/secret.key.
SECRET_KEY=

# Servidor
PORT=2567
DATABASE_PATH=./data/sqlite.db
ASSET_CACHE_DIR=./data/asset-cache
